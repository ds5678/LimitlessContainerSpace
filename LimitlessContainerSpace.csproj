<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>LimitlessContainerSpace</RootNamespace>
    <AssemblyName>LimitlessContainerSpace</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Il2Cpp interop assemblies for The Long Dark (2.55). Pulls in MelonLoader, HarmonyX and Il2CppInterop transitively. -->
    <PackageReference Include="STBlade.Modding.TLD.Il2CppAssemblies.Windows" Version="2.55.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Pin MelonLoader to the version TLD currently uses (the package above only requires 0.7.1). -->
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
